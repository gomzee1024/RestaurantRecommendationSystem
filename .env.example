# Copy to `.env` and fill in ONE provider's credentials.  Never commit `.env`.

# ---- Which LLM to use: watsonx | openai | anthropic ----------------------
LLM_PROVIDER=watsonx
# Optional overrides (provider defaults shown):
#   watsonx:   LLM_MODEL=ibm/granite-4-h-small   VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
#   openai:    LLM_MODEL=gpt-4o-mini             VISION_MODEL=gpt-4o-mini
#   anthropic: LLM_MODEL=claude-sonnet-5-5       VISION_MODEL=claude-sonnet-5-5
# LLM_MODEL=
# VISION_MODEL=
LLM_TEMPERATURE=0.7

# ---- IBM watsonx.ai (https://cloud.ibm.com -> watsonx.ai -> project) -----
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---- OpenAI ------------------------------------------------------------
# OPENAI_API_KEY=

# ---- Anthropic ---------------------------------------------------------
# ANTHROPIC_API_KEY=

# ---- MCP -----------------------------------------------------------------
# Leave empty to spawn the MCP server locally over stdio.
# Set to a URL to use a remote server over HTTP, e.g. http://localhost:8000/mcp
MCP_SERVER_URL=
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ---- Web UI ------------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=7860

# ---- Storage -------------------------------------------------------------
# DATA_DIR=./data
